# Ritual Bio environment variables
# Copy this file to .env.local and fill in the values.
# Vercel: set these in the project dashboard (NEXT_PUBLIC_* is inlined at build time).

# Deployed RitualBio contract address on Ritual Testnet (Chain ID 1979)
NEXT_PUBLIC_BIO_CONTRACT=0xa9FCC349BFaac8EAb15caDdd2d5Dae7636229483

# Ritual Chain RPC (optional — falls back to rpc.ritualfoundation.org)
NEXT_PUBLIC_RPC_URL=https://rpc.ritualfoundation.org

# web3.storage token for IPFS avatar uploads (optional — falls back to catbox.moe)
NEXT_PUBLIC_WEB3_TOKEN=
